{
  "name": "wtt-arena-pro",
  "version": "1.0.0",
  "private": true,
  "description": "WTT Arena Pro - a pocket table tennis game with local AI and P2P online play.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o .tailwind.generated.css && node scripts/inject-tailwind.mjs",
    "serve": "node server.js",
    "validate": "html-validate index.html && node scripts/check-inline-js.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/cli": "4.1.10",
    "html-validate": "^10.0.0",
    "tailwindcss": "4.1.10"
  }
}
